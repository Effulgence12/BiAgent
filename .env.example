# LLM provider (one shared key is enough for all agents in this course project)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions

# MySQL connection for production/report deployment
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agentic_bi_olist
PREFER_MYSQL=0

# Local runnable demo fallback
DATA_DIR=data/raw
LOCAL_DB_PATH=data/local/agentic_bi_olist.sqlite
AUTO_BOOTSTRAP_DATA=1

# App
APP_HOST=127.0.0.1
APP_PORT=8000
